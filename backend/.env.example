# Application
APP_NAME=AURA
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# PostgreSQL database connection
DATABASE_URL=postgresql+psycopg://aura:replace-me@localhost:5432/aura

# JWT access tokens — supply a securely generated signing secret
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Web refresh sessions — inactivity and fixed maximum since sign-in
REFRESH_SESSION_IDLE_DAYS=7
REFRESH_SESSION_MAX_DAYS=30
# Local HTTP only; production HTTPS must use true.
REFRESH_COOKIE_SECURE=false
# Use none + Secure only when the web and API are on separate sites.
REFRESH_COOKIE_SAMESITE=lax

# Daily market-data refresh worker
MARKET_DATA_UPDATE_TIME_UTC=02:00
MARKET_DATA_REFRESH_MAX_ATTEMPTS=3
MARKET_DATA_REFRESH_RETRY_SECONDS=10

# Approved forecasting artifact
FORECASTING_ARTIFACT_VERSION=forecast-v1-20260917

# AI explanation providers
OPENAI_API_KEY=
AURA_LLM_PROVIDER=
GROQ_API_KEY=
AURA_LLM_MODEL=
AURA_LLM_TIMEOUT_SECONDS=30
AURA_LLM_MAX_OUTPUT_TOKENS=1200

# Allowed web origins — explicit origins only, including the production web URL
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
