APP_NAME=AURA
APP_ENV=development
DEBUG=true
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://aura:replace-me@localhost:5432/aura
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MARKET_DATA_UPDATE_TIME_UTC=02:00
MARKET_DATA_REFRESH_MAX_ATTEMPTS=3
MARKET_DATA_REFRESH_RETRY_SECONDS=10
# Optional direct/session-pooled connection to the SAME database as DATABASE_URL.
# Do not use a transaction-pooled connection for advisory locks.
# MARKET_DATA_WORKER_DATABASE_URL=postgresql+psycopg://aura:replace-me@localhost:5432/aura
FORECASTING_ARTIFACT_VERSION=forecast-v1-20260917

OPENAI_API_KEY=
AURA_LLM_PROVIDER=
GROQ_API_KEY=
AURA_LLM_MODEL=
AURA_LLM_TIMEOUT_SECONDS=30
AURA_LLM_MAX_OUTPUT_TOKENS=1200

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
